<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FFCD03</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">#FFCD03</item>
        <item name="android:colorControlActivated">#FFCD03</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorHighlight">#66FFCD03</item>
    </style>
    <style name="DialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FFCD03</item>
        <item name="android:colorControlActivated">#FFCD03</item>
    </style>
    <style name="PickerTheme" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">#B89200</item>
        <item name="android:colorControlActivated">#FFCD03</item>
    </style>
</resources>
